#include <stdio.h>

int main()
{
    int duty_cycle = 5;
    int period = 10;
    int i;

    printf("PWM Simulation:\n");

    for (i = 0; i < period; i++)
    {
        if (i < duty_cycle)
        {
            printf("1");
        }
        else
        {
            printf("0");
        }
    }

    printf("\n");

    return 0;
}