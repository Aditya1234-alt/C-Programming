#include <stdio.h>
int main()
{
    int i, j;
    for(j = 1; j <= 3; j++)
    {
        printf("Cycle %d: ", j);
        for(i = 0; i < 10; i++)
        {
            if(i < 5)
                printf("1");
            else
                printf("0");
        }
        printf("\n");
    }
    return 0;
}